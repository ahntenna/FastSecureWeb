# 로컬 개발용 설정. scripts\setup.bat 이 이 파일을 backend\.env 로 복사한다.
# 운영 설정은 프로젝트 루트의 .env.example 을 본다. 이 파일을 운영에 쓰지 않는다.
APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_PATH=./data/app.db
SERVER_SIGN_KEY_FILE=../secrets/server_sign_key.pem

# http://localhost 로 접속하므로 Secure 쿠키를 끈다(운영 기본값은 true).
COOKIE_SECURE=false

# 프록시 도구로 평문 요청을 보며 디버깅하려면 false 로 바꾸고,
# frontend/.env.development.local 에 VITE_SECURE_CHANNEL=off 를 함께 넣는다.
SECURE_CHANNEL=true

# 개발 중에는 개발자 도구를 계속 쓰므로 가드 신호는 기록만 한다.
GUARD_POLICY=report
