# web 컨테이너의 nginx 설정 템플릿.
# 컨테이너 시작 시 ${WEB_PORT} ${API_HOST} ${API_PORT} ${TRUSTED_PROXY_CIDR} 가 환경 변수 값으로 치환된다
# (nginx 공식 이미지의 /etc/nginx/templates 기능). 포트 값은 프로젝트 루트의 ports.env 에서 온다.
#
# 구조: NPM(TLS 종료) → web(이 nginx: 정적 파일 + /api 프록시) → api
# TLS·HSTS·공통 보안 헤더(nosniff 등)는 NPM 에서 붙인다(docs/DEPLOY.md). 여기서는 CSP 만 붙인다.

# IP 기준 속도 제한 (1차 방어선. 앱에도 핸드셰이크 제한이 따로 있다)
limit_req_zone $binary_remote_addr zone=api_zone:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=hs_zone:10m rate=30r/m;
limit_req_status 429;

server {
    listen ${WEB_PORT};
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # 앞단 프록시(NPM)가 넘겨준 실제 클라이언트 IP 를 복원한다.
    # 신뢰할 대역은 .env 의 TRUSTED_PROXY_CIDR (NPM 이 속한 Docker 네트워크 대역)로 좁힌다.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    include /etc/nginx/snippets/csp.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # 핸드셰이크: 인증 없이 호출되므로 더 엄격하게 제한
    location = /api/hs {
        limit_req zone=hs_zone burst=10 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://${API_HOST}:${API_PORT};
    }

    location /api/ {
        limit_req zone=api_zone burst=40 nodelay;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://${API_HOST}:${API_PORT};
    }

    # 해시가 붙은 정적 자산: 길게 캐시
    location /assets/ {
        include /etc/nginx/snippets/csp.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA 진입점: 캐시 금지 (배포 후 즉시 새 번들 참조)
    location / {
        include /etc/nginx/snippets/csp.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    # 점(.)으로 시작하는 파일과 소스맵 차단
    location ~ /\.     { return 404; }
    location ~ \.map$  { return 404; }
}
