# 운영 설정 예시. 이 파일을 .env 로 복사해 값을 채운다. (.env 는 커밋하지 않는다)
# 여기의 기본값은 모두 "운영" 기준이다. 로컬 개발용 값은 backend/.env.dev.example 을 본다.
# 포트는 여기가 아니라 ports.env 에서 설정한다.

APP_ENV=production

# 서비스 도메인(쉼표 구분). 비어 있거나 * 가 들어 있으면 api 가 기동을 거부한다.
ALLOWED_HOSTS=example.com

# HTTPS 로만 서비스하므로 true. (세션 쿠키 이름이 __Host-sid 가 된다)
COOKIE_SECURE=true

# 클라이언트 가드(개발자 도구·디버거 탐지) 신호 처리
#   revoke: GUARD_REVOKE_SIGNALS 의 신호가 오면 그 세션을 무효화
#   report: 기록만 (오탐이 걱정되면 먼저 report 로 운영하며 security_events 를 살핀다)
GUARD_POLICY=revoke
GUARD_REVOKE_SIGNALS=devtools-timing,debugger-tamper

# web(nginx)이 X-Forwarded-For 를 신뢰할 앞단 프록시 대역. NPM 이 속한 Docker 네트워크 대역으로 좁힌다.
#   확인: docker network inspect proxy --format "{{(index .IPAM.Config 0).Subnet}}"
TRUSTED_PROXY_CIDR=172.16.0.0/12

# NPM 과 공유하는 외부 Docker 네트워크 이름 (docker-compose.npm.yml)
PROXY_NETWORK=proxy

# (선택) 번들 복제 방지용 도메인 잠금. 지정한 도메인에서만 프론트 코드가 실행된다.
#   예: OBF_DOMAIN_LOCK=example.com
OBF_DOMAIN_LOCK=
