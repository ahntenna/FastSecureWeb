# ─────────────────────────────────────────────────────────────────────────
# 포트 설정은 이 파일 한 곳에서만 한다.
# Docker(compose, nginx, api)와 로컬 개발 스크립트(Vite, 백엔드)가 모두 이 값을 읽는다.
# 값 뒤에 주석이나 공백을 붙이지 않는다.
# ─────────────────────────────────────────────────────────────────────────

# [Docker] 호스트에 게시하는 포트. 로컬 Docker 테스트(docker-compose.local.yml)에서만 쓰이며
#          127.0.0.1 에만 바인딩된다. 운영(NPM 뒤)에서는 호스트 포트를 열지 않는다.
WEB_HOST_PORT=8080

# [Docker] 컨테이너 내부 포트. NPM 의 Forward Port 에는 WEB_PORT 를 적는다.
WEB_PORT=8080
API_PORT=8000

# [로컬 개발] Docker 없이 실행할 때의 포트 (scripts\dev.bat)
DEV_WEB_PORT=5173
DEV_API_PORT=8000
