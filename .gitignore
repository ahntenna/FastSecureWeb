# ── 비밀 ────────────────────────────────────────────────────────────────
# 템플릿을 제자리에서 실행해 보면 templates/** 아래에 키·환경 파일이 생길 수 있다.
# (ports.env 는 비밀이 아니므로 "*.env" 로 막지 않는다)
.env
.env.*
!.env.example
!.env.dev.example
**/secrets/*
!**/secrets/.gitkeep
*.pem
*.key

# ── 데이터 ──────────────────────────────────────────────────────────────
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ── 의존성 ──────────────────────────────────────────────────────────────
node_modules/
.venv/
venv/

# ── 빌드·테스트 산출물 ──────────────────────────────────────────────────
dist/
target/
out/
__pycache__/
*.pyc
*.pyd
*.egg-info/
.pytest_cache/
*.map
*.tsbuildinfo

# ── 로그 ────────────────────────────────────────────────────────────────
*.log

# ── 도구·편집기·OS ──────────────────────────────────────────────────────
.claude/
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
